<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.egcmusicapp.PracticeController" stylesheets="@styles.css">

    
    <AnchorPane fx:id="backgroundPane" styleClass="anchor-pane" />

   
    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

       
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="backButton" text="← Back" onAction="#switchToHome" />
        </HBox>

      
        <HBox alignment="CENTER" spacing="10">
            <Label text="Song Select" styleClass="title-label" />
        </HBox>

    
        <HBox alignment="CENTER" spacing="10">
            <TextField fx:id="searchField" promptText="Search by title" />
            <ComboBox fx:id="genreComboBox" promptText="Genre" />
        </HBox>

        <ListView fx:id="songListView" maxWidth="800" />
    </VBox>
</StackPane>
