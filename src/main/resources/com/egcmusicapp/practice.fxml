<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.egcmusicapp.PracticeController" stylesheets="@styles.css">

    <!-- Background -->
    <AnchorPane fx:id="backgroundPane" styleClass="anchor-pane" />

    <!-- Main Content -->
    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" style="-fx-background-color: #9ba18f;">

        <!-- Top Bar: Back Arrow + Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Back arrow label (clickable) -->
            <Label text="←" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToHome" />

            <!-- Page title -->
            <Label text="Song Select" styleClass="title-label" />
        </HBox>

        <!-- Search and Filter -->
        <HBox alignment="CENTER" spacing="10">
            <TextField fx:id="searchField" promptText="Search by title" />
            <ComboBox fx:id="genreComboBox" promptText="Genre" style="-fx-background-color: #dfb9a9;"/>
        </HBox>

        <!-- Song List -->
        <ListView fx:id="songListView" maxWidth="800" />
    </VBox>
</StackPane>
