<?xml version="1.0" encoding="UTF-8"?>
<!-- Created by kayleigh faus -->

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.egcmusicapp.MyAccountController" prefWidth="800" prefHeight="500" style="-fx-background-color: #a2a88f;">
    <children>

        <!-- Profile Info -->
        <HBox spacing="20" alignment="CENTER_LEFT" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="30">
            <children>
                <ImageView fitHeight="150" fitWidth="150" preserveRatio="true">
                    <image>
                        <Image url="@images/gnome.png" />
                    </image>
                </ImageView>

                <VBox spacing="5">
                    <children>
                        <Label fx:id="lblUsername" text="Gnomer Simpson" style="-fx-font-size: 32px; -fx-font-weight: bold;" />
                        <Label text="Level 10" style="-fx-font-size: 18px;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Label text="XP" />
                                <ProgressBar fx:id="xpBar" prefWidth="200" progress="0.64" />
                                <Label fx:id="lblXP" text="3200/5000" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Created Songs Title -->
        <VBox spacing="10" AnchorPane.topAnchor="200" AnchorPane.leftAnchor="30">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="♪" style="-fx-font-size: 20px;" />
                        <Label text="Created Songs" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="♪" style="-fx-font-size: 20px;" />
                    </children>
                </HBox>

                <VBox spacing="5">
                    <children>
                        <HBox spacing="20">
                            <children>
                                <Label text="Title" style="-fx-font-weight: bold;" />
                                <Label text="Username" style="-fx-font-weight: bold;" />
                                <Label text="Genre" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <HBox spacing="20">
                            <children>
                                <Label text="Sample Song" />
                                <Label text="User123" />
                                <Label text="Lo-Fi" />
                            </children>
                        </HBox>
                        <HBox spacing="20">
                            <children>
                                <Label text="Track 2" />
                                <Label text="User123" />
                                <Label text="Jazz" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Daily Songs Completed -->
        <VBox spacing="5" alignment="CENTER" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="200">
            <children>
                <Label text="Daily Songs Completed" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Separator prefWidth="200" />
                <Label fx:id="lblDailySongs" text="34" style="-fx-font-size: 36px;" />
            </children>
        </VBox>

        <!-- Back to Home Button -->
        <Button text="Back to Home"
                AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20"
                onAction="#onBackToHomeClicked"
                style="-fx-background-color: #9ba18f; -fx-text-fill: white; -fx-font-weight: bold;" />

    </children>
</AnchorPane>
