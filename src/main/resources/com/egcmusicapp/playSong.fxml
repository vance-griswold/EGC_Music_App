<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.egcmusicapp.PlaySongController">
    <children>
        <Pane fx:id="sheetMusicPane" prefHeight="400.0" prefWidth="600.0">
            <children>
               <ImageView fx:id="imageView" fitHeight="150.0" fitWidth="200.0" layoutX="61.0" layoutY="83.0" pickOnBounds="true" preserveRatio="true">
                  
               </ImageView>
                <Label fx:id="lblNote" alignment="CENTER" contentDisplay="CENTER" layoutX="246.0" layoutY="115.0" prefHeight="94.0" prefWidth="108.0" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="B" textAlignment="CENTER">
               <font>
                  <Font size="96.0" />
               </font></Label>
            <Button fx:id="button" layoutX="8.0" layoutY="8.0" mnemonicParsing="false" onAction="#switchToPractice" prefHeight="25.0" prefWidth="22.0" text="&lt;-" style="-fx-background-color: #dfb9a9;">
               <font>
                  <Font size="9.0" />
               </font>
            </Button>
              <TextField fx:id="activeNote" alignment="CENTER" layoutX="242.0" layoutY="337.0" prefHeight="39.0" prefWidth="116.0" promptText="Active Note">
               <font>
                  <Font size="18.0" />
               </font>
            </TextField>
            <Label fx:id="lblScoreTop" alignment="CENTER" layoutX="19.0" layoutY="149.0" prefHeight="59.0" prefWidth="67.0" style="-fx-font-size: 28px; -fx-font-weight: bold;">
               <font>
                  <Font size="64.0" />
               </font>
            </Label>
            <Label fx:id="lblScoreBot" alignment="CENTER" layoutX="19.0" layoutY="206.0" prefHeight="59.0" prefWidth="67.0" style="-fx-font-size: 28px; -fx-font-weight: bold;">
               <font>
                  <Font size="64.0" />
               </font>
            </Label>
            <Line endX="-33.0" layoutX="119.0" layoutY="208.0" startX="-100.0" />
            <Label fx:id="lblScoreCard" alignment="CENTER" contentDisplay="CENTER" layoutX="1.0" layoutY="44.0" prefHeight="94.0" prefWidth="600.0" style="-fx-font-size: 26px; -fx-font-weight: bold;" textAlignment="CENTER">
               <font>
                  <Font size="96.0" />
               </font>
            </Label>
            <Button fx:id="printButton" layoutX="462.0" layoutY="8.0" mnemonicParsing="false" onAction="#printSheetMusic" prefHeight="39.0" prefWidth="138.0" text="Print Sheet Music" style="-fx-background-color: #dfb9a9;">
               <font>
                  <Font size="9.0" />
               </font>
            </Button>
            </children>
        </Pane>
    </children>
</VBox>
