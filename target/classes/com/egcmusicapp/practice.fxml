<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<StackPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8"
           fx:controller="com.egcmusicapp.PracticeController">

    <!-- Background Image -->
    <ImageView fx:id="someIcon" fitWidth="800" fitHeight="700" preserveRatio="false" opacity="0.5">
        <image>
            <Image url="@images/background2test.png"/>
        </image>
    </ImageView>

    <!-- Foreground Layout -->
    <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: transparent;">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <!-- Title -->
        <Label text="Practice Songs" style="-fx-font-size: 28px; -fx-font-weight: bold;" />

        <!-- Search and Genre -->
        <HBox alignment="CENTER" spacing="15" >
            <TextField fx:id="searchField" promptText="Search by title" prefWidth="300"/>
            <ComboBox fx:id="genreComboBox" promptText="Genre" prefWidth="150"/>
        </HBox>

        <!-- Table Header -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: rgba(255,255,255,0.6); -fx-padding: 8 16; -fx-background-radius: 10;">
            <Label text="Title" prefWidth="250"/>
            <Label text="Artist" prefWidth="200"/>
            <Label text="Genre" prefWidth="100"/>
            <Label text=" " prefWidth="50"/>
        </HBox>

        <!-- Example Song Row -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: rgba(255,255,255,0.9); -fx-padding: 10 16; -fx-background-radius: 10;">
            <Label text="Mary Had a Little Lamb" prefWidth="250"/>
            <Label text="Sarah Hale" prefWidth="200"/>
            <Label text="Classical" prefWidth="100"/>
            <Button text="＋" prefWidth="40" />
        </HBox>
    </VBox>

</StackPane>
