<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/8"
            fx:controller="com.egcmusicapp.CreateSongController"
            prefWidth="600" prefHeight="400">

    <children>
        <ImageView fx:id="gnomeImage"
                   fitWidth="150" fitHeight="200"
                   preserveRatio="true"
                   layoutX="20" layoutY="20">
            <Image url="@images/gnome_guitar.png"/> </ImageView>

        <Label layoutX="200" layoutY="20" text="[Name Your Song]" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <VBox layoutX="200" layoutY="60" spacing="10">
            <HBox spacing="10">
                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                    <Image url="@images/treble_clef.png"/>
                </ImageView>
                <Region prefWidth="300" prefHeight="20"/>
            </HBox>
            <HBox spacing="10">
                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                    <Image url="@images/treble_clef.png"/>
                </ImageView>
                <Region prefWidth="300" prefHeight="20"/>
            </HBox>
            <HBox spacing="10">
                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                    <Image url="@images/treble_clef.png"/>
                </ImageView>
                <Region prefWidth="300" prefHeight="20"/>
            </HBox>
        </VBox>

        <HBox layoutX="200" layoutY="200" spacing="20">
            <Button text="Add Whole Note" onAction="#addWholeNote"/>
            <Button text="Add Half Note" onAction="#addHalfNote"/>
            <Button text="Add Quarter Note" onAction="#addQuarterNote"/>
            <Button text="Add Eighth Note" onAction="#addEighthNote"/>
        </HBox>

        <HBox layoutX="200" layoutY="250" spacing="20">
            <Button text="Add Whole Rest" onAction="#addWholeRest"/>
            <Button text="Add Half Rest" onAction="#addHalfRest"/>
            <Button text="Add Quarter Rest" onAction="#addQuarterRest"/>
            <Button text="Add Eighth Rest" onAction="#addEighthRest"/>
        </HBox>

        <Button text="Create" layoutX="250" layoutY="320" onAction="#createMusic"/>

    </children>
</AnchorPane>