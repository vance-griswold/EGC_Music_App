<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.egcmusicapp.MyAccountController">

    <top>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10" />
        </padding>

        <!-- Back arrow label (clickable) -->
        <Label text="←" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#onBackToHomeClicked" />

        <!-- Page Title -->
        <Label text="My Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-underline: true;" />

    </HBox>
</top>


    <center>
        <VBox spacing="30" alignment="TOP_CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>

            <!-- Top Half (Name + XP Info) -->
            <HBox spacing="40" alignment="CENTER">
                <!-- Right (Name, Level, XP) -->
                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblWelcome" style="-fx-font-size: 36px; -fx-font-weight: bold;" />
                    <Label fx:id="lblLevel" style="-fx-font-size: 24px;" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="XP" style="-fx-font-size: 18px;" />
                        <ProgressBar fx:id="xpBar" prefWidth="300" prefHeight="20" />
                        <Label fx:id="lblXP" style="-fx-font-size: 16px;" />
                    </HBox>
                </VBox>
            </HBox>

            <Separator />

            <!-- Bottom Half (Created Songs + Daily Songs Completed) -->
            <HBox spacing="50" alignment="CENTER">
                
                <!-- Created Songs List -->
                <VBox spacing="15" alignment="CENTER">
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="🎵" style="-fx-font-size: 24px;" />
                        <Label text="Created Songs" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                        <Label text="🎵" style="-fx-font-size: 24px;" />
                    </HBox>
                    <Separator />
                    <ListView fx:id="userSongsList" prefWidth="300" prefHeight="250" style="-fx-background-radius: 10;" />
                </VBox>

                <!-- Daily Songs Completed -->
                <VBox spacing="15" alignment="CENTER">
                    <Label text="Daily Songs Completed" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                    <Separator />
                    <Label fx:id="lblDailySongs" style="-fx-font-size: 72px; -fx-font-weight: bold;" />
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
