<?xml version="1.0" encoding="UTF-8"?>
<!-- Created by kayleigh faus -->
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.egcmusicapp.MyAccountController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-color: #a2a88f;">

    <children>
        <!-- Greeting Label -->
        <Label fx:id="lblWelcome"
               text="Hello!"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               AnchorPane.topAnchor="10"
               AnchorPane.leftAnchor="30"/>

        <!-- Profile Info -->
        <HBox spacing="20" alignment="CENTER_LEFT"
              AnchorPane.topAnchor="60"
              AnchorPane.leftAnchor="30">
            <children>
                <ImageView fx:id="profileImage"
                           fitHeight="150" fitWidth="150"
                           preserveRatio="true">
                    <image>
                        <Image url="@images/gnome.png"/>
                    </image>
                </ImageView>

                <VBox spacing="5">
                    <children>
                        <Label fx:id="lblUsername"
                               text="Username"
                               style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

                        <Label fx:id="lblLevel"
                               text="Level 0"
                               style="-fx-font-size: 18px;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Label text="XP"/>
                                <ProgressBar fx:id="xpBar"
                                             prefWidth="200"
                                             progress="0"/>
                                <Label fx:id="lblXP"
                                       text="0/0"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Created Songs Table -->
        <VBox spacing="10"
              AnchorPane.topAnchor="240"
              AnchorPane.leftAnchor="30"
              AnchorPane.rightAnchor="30">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="♪" style="-fx-font-size: 20px;"/>
                        <Label text="Created Songs"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label text="♪" style="-fx-font-size: 20px;"/>
                    </children>
                </HBox>

                <TableView fx:id="tblCreatedSongs" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colTitle"
                                     text="Title"
                                     prefWidth="200"/>
                        <TableColumn fx:id="colUsername"
                                     text="Username"
                                     prefWidth="150"/>
                        <TableColumn fx:id="colGenre"
                                     text="Genre"
                                     prefWidth="150"/>
                    </columns>
                </TableView>
            </children>
        </VBox>

        <!-- Daily Songs Completed -->
        <VBox spacing="5" alignment="CENTER"
              AnchorPane.rightAnchor="30"
              AnchorPane.topAnchor="460">
            <children>
                <Label text="Daily Songs Completed"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Separator prefWidth="200"/>
                <Label fx:id="lblDailySongs"
                       text="0"
                       style="-fx-font-size: 36px;"/>
            </children>
        </VBox>

        <!-- Back to Home Button -->
        <Button text="Back to Home"
                AnchorPane.bottomAnchor="20"
                AnchorPane.leftAnchor="20"
                onAction="#onBackToHomeClicked"
                style="-fx-background-color: #9ba18f; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </children>
</AnchorPane>
