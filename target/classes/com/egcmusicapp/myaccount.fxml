<AnchorPane prefHeight="500" prefWidth="800" style="-fx-background-color: #a2a88f;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.egcmusicapp.MyAccountController">

    <children>

    <!-- Back Arrow -->
        <HBox alignment="CENTER_LEFT" spacing="10" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="10" />

        <!-- Greeting Label -->
        <Label fx:id="lblWelcome" layoutX="58.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Hello!" AnchorPane.leftAnchor="58.0" AnchorPane.topAnchor="14.0" />

        

        <!-- Profile Info -->
        <HBox alignment="CENTER_LEFT" spacing="20" AnchorPane.leftAnchor="30" AnchorPane.topAnchor="60">
            <children>
                <ImageView fx:id="profileImage" fitHeight="150" fitWidth="150" preserveRatio="true">
                    <image>
                        <Image url="@images/gnome.png" />
                    </image>
                </ImageView>
                <VBox spacing="5">
                    <children>
                        <Label fx:id="lblUsername" style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Username" />
                        <Label fx:id="lblLevel" style="-fx-font-size: 18px;" text="Level 0" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label text="XP" />
                                <ProgressBar prefWidth="200" progress="0" fx:id="xpBar" />
                                <Label fx:id="lblXP" text="0/0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
          <Label layoutX="20.0" layoutY="8.0" onMouseClicked="#onBackToHomeClicked" style="-fx-font-size: 24px; -fx-cursor: hand;" text="←" />

