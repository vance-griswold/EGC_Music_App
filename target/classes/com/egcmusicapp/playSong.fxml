<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.egcmusicapp.PlaySongController">
    <children>
        <Pane fx:id="sheetMusicPane" prefHeight="400.0" prefWidth="600.0">
            <children>
                <Canvas fx:id="sheetMusicCanvas" height="227.0" layoutX="42.0" layoutY="14.0" width="516.0" />
            <Button fx:id="button" layoutX="8.0" layoutY="8.0" mnemonicParsing="false" onAction="#switchToPractice" prefHeight="25.0" prefWidth="22.0" text="&lt;-">
               <font>
                  <Font size="9.0" />
               </font>
            </Button>
            </children>
        </Pane>
        <TextField fx:id="activeNote" layoutX="14.0" layoutY="14.0" promptText="Active Note" />
    </children>
</VBox>
